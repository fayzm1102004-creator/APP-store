{
  "expo": {
    "name": "MarketplaceMobile",
    "slug": "MarketplaceMobile",
    "version": "1.0.0",
    "scheme": "marketplacemobile",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "السماح بالدخول السريع والآمن بالبصمة / Allow Face ID for quick and secure biometric login"
      }
    },
    "android": {
      "package": "com.marketplace.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-web-browser",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "السماح بالدخول السريع والآمن بالبصمة / Allow Face ID for quick and secure biometric login"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "السماح بالدخول السريع والآمن بالبصمة / Allow Face ID for quick and secure biometric login"
        }
      ]
    ],
    "extra": {
      "supportsRTL": true
    }
  }
}
